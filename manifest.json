{
  "manifest_version": 3,
  "name": "PSU Canvas Grade Focus",
  "version": "1.0",
  "description": "Hide 100%s, filter ungraded assignments, and see true final grade impact on Canvas.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Canvas Grade Focus"
  },
  "content_scripts": [
    {
      "matches": ["https://psu.instructure.com/courses/*/grades*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
